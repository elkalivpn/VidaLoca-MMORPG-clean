
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "vidaloca_vault"]
}

// ============================================
// VIDA LOCA MMORPG - DATABASE SCHEMA
// ============================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String    @unique
  password            String
  role                UserRole  @default(PLAYER)
  isBanned            Boolean   @default(false)
  banReason           String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(0)
  lastPasswordChange  DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  player              Player?
  refreshTokens       RefreshToken[]
  
  @@map("users")
  @@schema("public")
}

enum UserRole {
  PLAYER
  ADMIN
  MODERATOR

  @@schema("public")
}

enum FactionType {
  CIVILIAN
  POLICE
  GUARDIA_CIVIL
  SYNDICATE
  ENTREPRENEUR

  @@schema("public")
}

model Player {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  displayName     String
  level           Int      @default(1)
  xp              Int      @default(0)
  reputation      Int      @default(0)
  
  euros           Float    @default(100.0)
  dirtyEuros      Float    @default(0)
  vidaCoins       Int      @default(0)
  
  locationId      String?  @default("madrid_centro")
  heat            Int      @default(0)
  wantedLevel     Int      @default(0)
  faction         FactionType @default(CIVILIAN)
  factionRank     Int      @default(1)
  jailUntil       DateTime?
  lifestyle       String   @default("GREY")
  isOnline        Boolean  @default(false)
  lastLogin       DateTime @default(now())
  
  inventory       InventoryItem[]
  vehicles        PlayerVehicle[]
  properties      PlayerProperty[]
  weapons         PlayerWeapon[]
  clanMember      ClanMember?
  missions        PlayerMission[]
  battlePass      BattlePassProgress?
  achievements    PlayerAchievement[]
  transactions    TransactionLog[]
  skills          PlayerSkill[]
  completedMissions CompletedMission[]
  gameSessions    GameSession[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("players")
  @@schema("public")
}

model ItemTemplate {
  id          String   @id @default(uuid())
  name        String
  description String
  type        ItemType
  rarity      Rarity   @default(COMMON)
  stats       Json?
  priceEuros  Float?
  priceVida   Int?
  
  items       InventoryItem[]
  
  @@map("item_templates")
  @@schema("public")
}

enum ItemType {
  WEAPON
  VEHICLE
  HOUSE
  CONSUMABLE
  SKILL_CARD
  COSMETIC

  @@schema("public")
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY

  @@schema("public")
}

model InventoryItem {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  templateId String
  template  ItemTemplate @relation(fields: [templateId], references: [id])
  
  quantity  Int      @default(1)
  equipped  Boolean  @default(false)
  acquiredAt DateTime @default(now())
  
  @@map("inventory")
  @@schema("public")
}

model VehicleTemplate {
  id          String   @id @default(uuid())
  name        String
  brand       String
  speed       Int
  handling    Int
  durability  Int
  capacity    Int
  priceEuros  Float?
  priceVida   Int?
  
  vehicles    PlayerVehicle[]
  
  @@map("vehicle_templates")
  @@schema("public")
}

model PlayerVehicle {
  id           String   @id @default(uuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  templateId   String
  template     VehicleTemplate @relation(fields: [templateId], references: [id])
  
  licensePlate String   @unique
  color        String   @default("white")
  condition    Float    @default(100.0)
  isPrimary    Boolean  @default(false)
  
  @@map("player_vehicles")
  @@schema("public")
}

model PropertyTemplate {
  id          String   @id @default(uuid())
  name        String
  location    String
  type        PropertyType
  capacity    Int
  security    Int
  priceEuros  Float
  priceVida   Int?
  rentYield   Float?
  
  properties  PlayerProperty[]
  
  @@map("property_templates")
  @@schema("public")
}

enum PropertyType {
  APARTMENT
  MANSION
  WAREHOUSE
  CLUB
  GARAGE

  @@schema("public")
}

model PlayerProperty {
  id                  String    @id @default(uuid())
  playerId            String
  player              Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  templateId          String
  template            PropertyTemplate @relation(fields: [templateId], references: [id])
  
  purchasedAt         DateTime  @default(now())
  lastRentCollectedAt DateTime?
  lastUsedAt          DateTime?
  customized          Json?
  
  @@map("player_properties")
  @@schema("public")
}

model Clan {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String   @unique
  leaderId    String   @unique
  funds       Float    @default(0.0)
  level       Int      @default(1)
  xp          Int      @default(0)
  
  members     ClanMember[]
  territories ClanTerritory[]
  controlledTerritories Territory[]
  
  createdAt   DateTime @default(now())
  
  @@map("clans")
  @@schema("public")
}

model ClanMember {
  id        String   @id @default(uuid())
  playerId  String   @unique
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  
  role      ClanRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  
  @@map("clan_members")
  @@schema("public")
}

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
  RECRUIT

  @@schema("public")
}

model Territory {
  id          String   @id @default(uuid())
  name        String
  city        String
  incomeRate  Float
  bonusType   String?
  
  controllerId String?
  controller   Clan?     @relation(fields: [controllerId], references: [id], onDelete: SetNull)
  controls     ClanTerritory[]
  
  @@map("territories")
  @@schema("public")
}

model ClanTerritory {
  id          String   @id @default(uuid())
  clanId      String
  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  territoryId String   @unique
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  
  capturedAt  DateTime @default(now())
  
  @@map("clan_territories")
  @@schema("public")
}

enum MissionMode {
  STORY
  ONLINE_SOLO
  ONLINE_COOP

  @@schema("public")
}

model MissionTemplate {
  id              String      @id @default(uuid())
  title           String
  description     String
  difficulty      Difficulty
  mode            MissionMode @default(ONLINE_SOLO)
  category        String      @default("GENERAL")
  city            String?
  minLevel        Int         @default(1)
  minPlayers      Int         @default(1)
  maxPlayers      Int         @default(1)
  isOptional      Boolean     @default(true)
  isRepeatable    Boolean     @default(false)
  cooldownHours   Int         @default(0)
  requiredSteps   Int         @default(3)
  rewardEuros     Float
  rewardXp        Int
  rewardVidaCoins Int         @default(0)
  rewardReputation Int        @default(0)
  rewardItemName  String?
  unlockBenefit   String?
  requirement     Json?
  
  instances       PlayerMission[]
  completions     CompletedMission[]
  
  @@map("mission_templates")
  @@schema("public")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  SUICIDE

  @@schema("public")
}

model PlayerMission {
  id               String        @id @default(uuid())
  playerId         String
  player           Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  templateId       String
  template         MissionTemplate @relation(fields: [templateId], references: [id])
  
  status           MissionStatus @default(PENDING)
  progress         Int           @default(0)
  squadCode        String?
  coOpParticipants Json?
  lastStepAt       DateTime?
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  
  @@map("player_missions")
  @@schema("public")
}

enum MissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CLAIMED
  ABANDONED
  SKIPPED

  @@schema("public")
}

model CompletedMission {
  id            String          @id @default(uuid())
  playerId      String
  player        Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId     String
  mission       MissionTemplate @relation(fields: [missionId], references: [id])
  
  completedAt   DateTime        @default(now())
  rewardClaimed Boolean         @default(false)
  
  @@map("completed_missions")
  @@schema("public")
}

model BattlePassSeason {
  id           String   @id @default(uuid())
  seasonNumber Int
  name         String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(false)
  
  progresses   BattlePassProgress[]
  
  @@map("battle_pass_seasons")
  @@schema("public")
}

model BattlePassProgress {
  id             String   @id @default(uuid())
  playerId       String   @unique
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId       String
  season         BattlePassSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  
  level          Int      @default(1)
  xp             Int      @default(0)
  isPremium      Boolean  @default(false)
  rewardsClaimed Int[]
  
  @@map("battle_pass_progress")
  @@schema("public")
}

model TransactionLog {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  
  type      TransactionType
  amount    Float
  currency  Currency
  
  reason    String
  reference String?
  
  createdAt DateTime @default(now())
  
  @@map("transaction_logs")
  @@schema("public")
}

enum TransactionType {
  EARN
  SPEND
  PURCHASE
  GIFT
  PENALTY

  @@schema("public")
}

enum Currency {
  EUR
  VIDACOIN

  @@schema("public")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash    String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  
  @@map("refresh_tokens")
  @@schema("public")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String
  maxLevel    Int      @default(10)
  category    SkillCategory
  
  players     PlayerSkill[]
  
  @@map("skills")
  @@schema("public")
}

enum SkillCategory {
  COMBAT
  DRIVING
  STEALTH
  BUSINESS
  SOCIAL

  @@schema("public")
}

model PlayerSkill {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  level     Int      @default(1)
  xp        Int      @default(0)
  
  @@unique([playerId, skillId])
  @@map("player_skills")
  @@schema("public")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String
  condition   Json     // { "type": "reach_level", "value": 50 }
  rewardVida  Int      @default(0)
  rewardEuros Float    @default(0.0)
  
  players     PlayerAchievement[]
  
  @@map("achievements")
  @@schema("public")
}

model PlayerAchievement {
  id            String   @id @default(uuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  unlockedAt    DateTime @default(now())
  
  @@unique([playerId, achievementId])
  @@map("player_achievements")
  @@schema("public")
}

model PlayerWeapon {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  name      String
  damage    Int
  range     Int
  accuracy  Int
  equipped  Boolean  @default(false)
  
  @@map("player_weapons")
  @@schema("public")
}

model GameSession {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  startTime   DateTime @default(now())
  endTime     DateTime?
  sessionData Json?    // Actividad durante la sesión
  
  @@map("game_sessions")
  @@schema("public")
}

// ============================================
// SECURITY AUDIT & ANTI-CHEAT TELEMETRY
// ============================================

model SecurityAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  eventType  String
  severity   String   @default("INFO") // INFO | WARN | HIGH | CRITICAL
  target     String?
  ipHash     String?
  details    Json?
  prevHash   String
  entryHash  String   @unique
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_audit_logs")
  @@schema("public")
}

model AntiCheatIncident {
  id          String   @id @default(uuid())
  userId      String?
  playerId    String?
  rule        String   // SPEEDHACK | TELEPORT | RATE_ABUSE | PROMPT_INJECT | ECONOMY_TAMPER | DOUBLE_CLAIM
  severity    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  strikes     Int      @default(1)
  blocked     Boolean  @default(true)
  evidence    Json?
  createdAt   DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([userId, createdAt])
  @@map("anti_cheat_incidents")
  @@schema("public")
}

// ============================================
// CAJA ULTRA-BLINDADA (ISOLATED SCHEMA "vault")
// Envelope-encrypted (AES-256-GCM) payment tokens & sensitive PII/KYC
// ============================================

enum VaultRecordType {
  PAYMENT_CARD
  IDENTITY_KYC
  RECOVERY_SECRET

  @@schema("vidaloca_vault")
}

model VaultRecord {
  id               String          @id @default(uuid())
  vaultToken       String          @unique // Opaque token returned to app layer (never raw PAN/SSN)
  ownerUserIdHash  String          // HMAC-SHA256 keyed hash of userId (no plain user FK leakage)
  recordType       VaultRecordType
  keyVersion       Int             @default(1)
  algorithm        String          @default("AES-256-GCM")
  encryptedDek     String          // Per-record DEK wrapped by VAULT_MASTER_KEY (iv:tag:cipher)
  iv               String          // 96-bit random IV (base64)
  authTag          String          // 128-bit GCM auth tag (base64)
  encryptedPayload String          // AES-256-GCM ciphertext of sensitive JSON
  blindIndex       String          // HMAC-SHA256 blind index for deduplication without decrypting
  maskedSummary    String          // Safe display string ONLY e.g. "VISA •••• 4242 (12/29)"
  cardBrand        String?
  cardLast4        String?
  expMonth         Int?
  expYear          Int?
  isRevoked        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  accessLogs       VaultAccessLog[]

  @@index([ownerUserIdHash, recordType])
  @@index([blindIndex])
  @@map("vault_records")
  @@schema("vidaloca_vault")
}

model VaultAccessLog {
  id            String      @id @default(uuid())
  vaultRecordId String?
  vaultRecord   VaultRecord? @relation(fields: [vaultRecordId], references: [id], onDelete: SetNull)
  actorIdHash   String
  action        String      // TOKENIZE | LIST_MASKED | VERIFY_TOKEN | REVOKE | ROTATE_KEY | DENIED
  outcome       String      // ALLOWED | BLOCKED
  ipHash        String?
  reason        String?
  prevHash      String
  entryHash     String      @unique
  createdAt     DateTime    @default(now())

  @@index([actorIdHash, createdAt])
  @@map("vault_access_logs")
  @@schema("vidaloca_vault")
}

