# ============================================
# VidaLoca MMORPG - Environment Variables
# ============================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Database (PostgreSQL - Neon, Railway, local, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Redis (opcional pero recomendado para sesiones y caché)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="cambia-este-secreto-por-uno-muy-largo-y-aleatorio"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Frontend (CORS)
FRONTEND_URL="http://localhost:3001"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
