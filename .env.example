# =========================
# VidaLoca MMORPG – variables de entorno
# Copia a .env y rellena. NUNCA subas .env al repo.
# =========================

# PostgreSQL (Neon recommended: use pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional direct (non-pooled) for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Redis (opcional en local; docker-compose lo levanta)
REDIS_URL="redis://localhost:6379"

# Auth – genera uno fuerte: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# API
PORT=3000
NODE_ENV=development

# CORS – origen del cliente Next.js
CORS_ORIGIN="http://localhost:3001"
